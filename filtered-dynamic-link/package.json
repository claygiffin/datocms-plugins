{
  "name": "datocms-plugin-filtered-dynamic-link",
  "description": "A custom link field that filters available links based on a specified record field.",
  "homepage": "https://github.com/claygiffin/datocms-plugins/filtered-dynamic-link",
  "private": false,
  "version": "0.1.0",
  "author": "Clay Giffin <clay@claygiffin.com>",
  "type": "module",
  "keywords": [
    "datocms-plugin"
  ],
  "datoCmsPlugin": {
    "title": "Filtered Dynamic Link",
    "entryPoint": "dist/index.html",
    "permissions": []
